<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <!-- Version comes from Directory.Build.props as yyMM.<commit count>. -->
    <!-- Set by the release workflow from the annotated tag's message, so the shipped manifest
         carries the changelog. It cannot come from the GitHub release body: that release is created
         after the build. Empty for local builds. -->
    <Changelog Condition="'$(Changelog)' == ''"></Changelog>
    <Authors>Solona</Authors>
    <Company />
    <Description>Presents FFXIV's camera to ReShade as an IGCS camera tool, so accumulation depth-of-field add-ons such as iMMERSE Parallax DoF and IGCS DoF can drive it.</Description>
    <PackageProjectUrl>https://github.com/solona-m/camera-tools-ffxiv</PackageProjectUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The native IGCS export shim is built separately (src/native/IgcsBridge) and
       shipped alongside the plugin assembly; the plugin LoadLibrary's it at runtime. -->
  <ItemGroup>
    <None Include="..\..\build\native\Release\IgcsBridge.dll"
          Condition="Exists('..\..\build\native\Release\IgcsBridge.dll')">
      <Link>IgcsBridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
